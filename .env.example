# Скопируй в .env и заполни
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Frunze Travel Bot
TELEGRAM_BOT_TOKEN=     # старый одиночный дев-бот (keyword-детект). Для песочницы используй TELEGRAM_BOTS ниже.

# Тестовые Telegram-боты (песочница: туры/визы) — по боту на сценарий, вебхук POST /webhook/telegram/<id>.
# Гейтинг отдельно от WhatsApp: глобальный bots_enabled держим OFF, тест-боты включаем
# персональным флагом bots_enabled:<id> (см. docs/telegram-test-bots.md).
# TELEGRAM_BOTS=[{"id":"frunze_tours_tg","scenario":"tours","title":"Frunze туры (тест)","token":"123:ABC"},{"id":"getvisa_tg","scenario":"visa","title":"GetVisa (тест)","token":"456:DEF"}]

# Wappi Pro (WhatsApp) — token и profile_id из кабинета wappi.pro
WAPPI_BASE_URL=https://wappi.pro
WAPPI_TOKEN=
WAPPI_PROFILE_ID=
# Прямой WhatsApp-тест (Схема B): в кабинете Wappi указать webhook → https://<домен>/webhook/wappi
# Маршрутизация по profile_id берётся из BOTS (ниже у каждого бота свой wappi_profile_id).
# Пример BOTS:
# BOTS=[{"id":"frunze_tours","scenario":"tours","title":"FrunzeTravel2","wappi_profile_id":"02a4708d-ec6c"},{"id":"getvisa","scenario":"visa","title":"GetVisa","wappi_profile_id":"2f099bc3-478d"}]

# TourVisor — кабинетные логин/пароль (подходят и для XML API)
TOURVISOR_LOGIN=
TOURVISOR_PASS=

# Хранилище
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/frunze
REDIS_URL=redis://localhost:6379/0
STATE_BACKEND=memory    # memory (дев/тесты) | redis (прод: диалоги переживают рестарт)
STATE_TTL_SECONDS=604800  # TTL неактивного диалога в Redis (по умолч. 7 дней)
# Прод (docker-compose): пароль БД и бэкенды. В compose DATABASE_URL/REDIS_URL
# переопределяются на имена сервисов db/redis автоматически.
POSTGRES_PASSWORD=postgres

# LLM модели
LLM_MODEL_MAIN=anthropic/claude-3.5-sonnet
LLM_MODEL_CHEAP=anthropic/claude-3-haiku

# CRM-бэкенд: stub (память) | postgres (персистентный локальный слой) | bitrix24 (Фаза 2)
CRM_BACKEND=stub
# Фаза 2 — Bitrix24
BITRIX24_WEBHOOK_URL=

# Админ-панель (канбан + чат + перехват). Прод: PANEL_BACKEND=postgres.
PANEL_BACKEND=memory
ADMIN_ENABLED=true
ADMIN_USER=admin
ADMIN_PASSWORD=frunze    # ОБЯЗАТЕЛЬНО сменить в проде
